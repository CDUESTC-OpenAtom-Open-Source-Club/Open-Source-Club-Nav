{
    "openapi": "3.0.0",
    "info": {
        "contact": {},
        "title": "",
        "version": ""
    },
    "paths": {
        "/backend/admin/list": {
            "get": {
                "description": "查看所有管理员账号",
                "tags": [
                    "管理员"
                ],
                "summary": "获取管理员列表",
                "responses": {
                    "200": {
                        "description": "管理员列表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/model.User"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "description": "账号密码登录，获取Token",
                "tags": [
                    "用户"
                ],
                "summary": "用户登录",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/model.User"
                            }
                        }
                    },
                    "description": "登录信息",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/nav/search": {
            "get": {
                "description": "搜索导航标题或描述含关键词的站点",
                "tags": [
                    "导航站"
                ],
                "summary": "搜索导航站点",
                "parameters": [
                    {
                        "description": "搜索关键词",
                        "name": "keyword",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "搜索结果列表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/model.NavItem"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "新用户注册，创建账号",
                "tags": [
                    "用户"
                ],
                "summary": "用户注册",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/model.User"
                            }
                        }
                    },
                    "description": "注册信息",
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "注册成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "model.NavItem": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "string"
                    },
                    "coverUrl": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "linkUrl": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    }
                }
            },
            "model.User": {
                "type": "object",
                "properties": {
                    "createdAt": {
                        "type": "string"
                    },
                    "deletedAt": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "id": {
                        "type": "integer"
                    },
                    "password": {
                        "type": "string"
                    },
                    "passwordHash": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string"
                    },
                    "updatedAt": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                }
            }
        }
    }
}