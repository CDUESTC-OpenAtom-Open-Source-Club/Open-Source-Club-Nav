# ============================================
# GitHub API Configuration
# ============================================
GITHUB_TOKEN=your_github_token_here
NEXT_PUBLIC_GITHUB_ORG=your_github_org_name

# Backend login bypass: default secure (off). Set to true only for local dev.
# Production (NODE_ENV=production) always enforces login.
ADMIN_BYPASS_LOGIN=false

# Go backend API address (BFF proxy target)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080
