# ============================================
# GitHub API Configuration
# ============================================
GITHUB_TOKEN=your_github_token_here
NEXT_PUBLIC_GITHUB_ORG=your_github_org_name

# Backend login bypass: default secure (off). Set to true only for local dev.
# Production (NODE_ENV=production) always enforces login.
ADMIN_BYPASS_LOGIN=false

# Go backend API address (BFF proxy target)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080

# ============================================
# SEO Push Configuration (搜索引擎主动推送)
# ============================================

# 百度站长推送 (https://ziyuan.baidu.com/linksubmit/index)
BAIDU_PUSH_SITE=nav.kcos.club
BAIDU_PUSH_TOKEN=your_baidu_push_token

# Google Indexing API (https://developers.google.com/search/apis/indexing-api/v3/quickstart)
# 需要 Google Service Account JSON 密钥
GOOGLE_INDEXING_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# IndexNow (https://www.indexnow.org/documentation)
# 用于 Bing/Yandex/Naver/Seznam 等联合索引推送
INDEXNOW_KEY=kcosclubindexnowkey2026
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_KEY_LOCATION=https://nav.kcos.club/kcosclubindexnowkey2026.txt
