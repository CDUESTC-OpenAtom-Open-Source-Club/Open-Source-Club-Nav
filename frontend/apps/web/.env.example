# ============================================
# 数据源切换
# true  = 所有接口返回模拟数据（开发/演示用）
# false = 调用真实 API（GitHub + Go 后端）
# ============================================
USE_MOCK_DATA=true

# GitHub API（USE_MOCK_DATA=false 时生效）
GITHUB_TOKEN=your_github_token_here
NEXT_PUBLIC_GITHUB_ORG=your_github_org_name

# 后台登录绕过：默认安全（关闭）。仅本地开发可显式设为 true 临时跳过登录；
# 生产环境(NODE_ENV=production)始终强制关闭，无法绕过。
ADMIN_BYPASS_LOGIN=false

# Go 后端 API 地址（前端 BFF 代理目标，所有数据操作统一走此后端）
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8080

# ============================================
# 以下变量已弃用（前端不再直连数据库，由 Go 后端管理）
# 仅供回滚参考，后续将移除：
# MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE
# ADMIN_AUTH_SECRET, ADMIN_BOOTSTRAP_USERNAME, ADMIN_BOOTSTRAP_PASSWORD
# NEXT_PUBLIC_USE_MOCK_MODE
# ============================================
