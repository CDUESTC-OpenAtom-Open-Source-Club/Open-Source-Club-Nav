# ============================================
# 数据源切换
# true  = 所有接口返回模拟数据（开发/演示用）
# false = 调用真实 API（GitHub + MySQL）
# ============================================
USE_MOCK_DATA=true

# GitHub API（USE_MOCK_DATA=false 时生效）
GITHUB_TOKEN=your_github_token_here

# MySQL 数据库（USE_MOCK_DATA=false 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kcos_nav
# 后台登录绕过：默认安全（关闭）。仅本地开发可显式设为 true 临时跳过登录；
# 生产环境(NODE_ENV=production)始终强制关闭，无法绕过。
ADMIN_BYPASS_LOGIN=false
# 后台会话签名密钥：生产环境必须设置且不能为空，否则服务会拒绝签发/校验会话。
ADMIN_AUTH_SECRET=replace_with_a_random_secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_this_password
NEXT_PUBLIC_USE_MOCK_MODE=false
